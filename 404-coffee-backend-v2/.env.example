NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/coffee404_v2?replicaSet=rs0
MONGODB_CONNECT_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=1000
HTTP_SHUTDOWN_GRACE_MS=10000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
BUSINESS_TIMEZONE=Africa/Cairo
BUSINESS_CURRENCY=EGP
BUSINESS_NAME=404 Coffee
BUSINESS_ADDRESS=
TAX_RATE=0
SERVICE_RATE=0
DELIVERY_FEE=0
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_MS=8000
MEDIA_STORAGE_DIR=./uploads
MEDIA_URL_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30
